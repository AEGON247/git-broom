{
  "name": "@sachin-dev/git-broom",
  "version": "1.0.0",
  "description": "Production-ready CLI to safely untrack Git files, update .gitignore, and optionally purge history.",
  "type": "module",
  "bin": {
    "git-broom": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "git",
    "cli",
    "git-broom",
    "gitignore",
    "untrack",
    "git-rm-cached",
    "history-purge",
    "git-filter-repo",
    "git-plugin"
  ],
  "author": "Sachin Mehta",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^13.1.0",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
